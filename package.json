{
	"name": "@somehow-digital/ui",
	"type": "module",
	"version": "1.0.0",
	"packageManager": "pnpm@12.21.0",
	"description": "Design system for somehow.digital projects.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/somehow-digital/ui.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"exports": {
		".": {
			"types": "./dist/ui.d.ts",
			"import": "./dist/ui.js"
		},
		"./preset": {
			"types": "./dist/preset.d.ts",
			"import": "./dist/preset.js"
		}
	},
	"main": "./dist/ui.js",
	"types": "./dist/ui.d.ts",
	"files": [
		"./dist/"
	],
	"engines": {
		"node": ">=24",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "concurrently --group --prefix-colors 'auto' 'pnpm:dev:*'",
		"dev:vite": "vp build --watch",
		"dev:storybook": "storybook dev",
		"build": "concurrently --group --prefix-colors 'auto' 'pnpm:build:*'",
		"build:vite": "vp build",
		"build:storybook": "storybook build --docs",
		"prepack": "vp build",
		"prepare": "vp config --no-agent",
		"test": "vp test run",
		"lint": "concurrently --group --prefix-colors 'auto' 'pnpm:lint:*'",
		"lint:vue": "vue-tsc --build",
		"lint:eslint": "eslint .",
		"lint:cspell": "cspell --no-progress --no-summary --no-must-find-files .",
		"lint:knip": "knip --no-progress",
		"fix": "eslint --fix ."
	},
	"peerDependencies": {
		"reka-ui": "^2.0.0",
		"unocss": "^66.6.0",
		"vue": "^3.5.26"
	},
	"dependencies": {
		"@somehow-digital/unocss-preset": "^2.2.1",
		"motion": "^14.14.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@fontsource-variable/gabarito": "^5.3.0",
		"@microsoft/api-extractor": "^7.60.1",
		"@somehow-digital/commitlint-config": "^1.0.0",
		"@somehow-digital/cspell-dictionary": "^2.0.0",
		"@somehow-digital/eslint-config": "^5.0.0",
		"@somehow-digital/semantic-release-config": "^2.0.0",
		"@storybook/addon-docs": "^10.2.0",
		"@storybook/addon-themes": "^10.2.0",
		"@storybook/addon-vitest": "^10.2.7",
		"@storybook/vue3-vite": "^10.2.0",
		"@tsconfig/node24": "^24.0.4",
		"@types/node": "^26.0.0",
		"@vitejs/plugin-vue": "^6.0.3",
		"@vitest/browser-playwright": "^5.0.5",
		"@vue/tsconfig": "^0.9.0",
		"concurrently": "^10.0.0",
		"cspell": "^10.0.0",
		"eslint": "^10.0.0",
		"knip": "^6.0.0",
		"playwright": "^1.58.2",
		"reka-ui": "^2.0.0",
		"semantic-release": "^25.0.2",
		"storybook": "^10.2.0",
		"typescript": "^6.0.0",
		"unocss": "^66.0.0",
		"unplugin-dts": "^1.0.0",
		"vite": "^8.0.0",
		"vite-plugin-vue-devtools": "^8.0.5",
		"vite-plus": "1.6.0",
		"vitest": "^5.0.5",
		"vue": "^3.5.26",
		"vue-tsc": "^3.2.2"
	}
}
